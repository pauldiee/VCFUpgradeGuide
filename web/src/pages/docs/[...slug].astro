---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { NAV, navBySlug } from '../../nav';
import { docHref as href } from '../../lib/path';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);
// On-this-page nav: H2 sections plus their H3 subsections, so long docs
// (the upgrade overview) are navigable to a specific phase / sub-topic.
const sections = headings.filter((h) => h.depth === 2 || h.depth === 3);
const topLevel = sections.filter((h) => h.depth === 2);

const meta = navBySlug(doc.id);
const idx = NAV.findIndex((n) => n.slug === doc.id);
const prev = idx > 0 ? NAV[idx - 1] : undefined;
const next = idx >= 0 && idx < NAV.length - 1 ? NAV[idx + 1] : undefined;

const title = meta ? `${meta.label} – VCF Upgrade Guide` : 'VCF Upgrade Guide';
---

<BaseLayout title={title} description={meta?.blurb} active={doc.id}>
  <div class="doc-head" data-pagefind-ignore>
    {meta && <p class="doc-eyebrow itq-eyebrow">{meta.step}</p>}
    <button
      type="button"
      class="btn btn--primary btn--sm doc-download-pdf"
      data-slug={doc.id}
    >
      <i class="fa-solid fa-file-pdf" aria-hidden="true"></i> Download PDF
    </button>
  </div>
  {
    topLevel.length > 2 && (
      <nav class="doc-toc" aria-label="On this page" data-pagefind-ignore>
        <span class="doc-toc__label">On this page</span>
        <ul class="doc-toc__list">
          {sections.map((h) => (
            <li class={h.depth === 3 ? 'doc-toc__sub' : undefined}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  <article class="doc prose">
    <Content />
  </article>

  <nav class="doc-pager" aria-label="Between documents" data-pagefind-ignore>
    {
      prev ? (
        <a class="doc-pager__link doc-pager__link--prev" href={href(prev.slug)}>
          <span class="doc-pager__dir"><i class="fa-solid fa-arrow-left" aria-hidden="true" /> Previous</span>
          <span class="doc-pager__title">{prev.label}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a class="doc-pager__link doc-pager__link--next" href={href(next.slug)}>
          <span class="doc-pager__dir">Next <i class="fa-solid fa-arrow-right" aria-hidden="true" /></span>
          <span class="doc-pager__title">{next.label}</span>
        </a>
      )
    }
  </nav>
</BaseLayout>

{/* Renders this doc's own <article class="doc prose"> to a downloaded PDF file
    client-side (no server/CI Chromium involved) via html2pdf.js, loaded from
    the CDN on first click rather than on every page load. Forces light theme
    for the capture regardless of the viewer's current scheme, since a
    rasterized dark-mode PDF reads poorly on paper, then restores it after. */}
<script is:inline>
  (function () {
    var btn = document.querySelector('.doc-download-pdf');
    if (!btn) return;
    var HTML2PDF_SRC = 'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js';
    var loadPromise = null;
    function loadHtml2pdf() {
      if (window.html2pdf) return Promise.resolve();
      if (!loadPromise) {
        loadPromise = new Promise(function (resolve, reject) {
          var s = document.createElement('script');
          s.src = HTML2PDF_SRC;
          s.onload = resolve;
          s.onerror = reject;
          document.head.appendChild(s);
        });
      }
      return loadPromise;
    }
    btn.addEventListener('click', function () {
      var original = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Preparing…';
      var root = document.documentElement;
      var priorTheme = root.dataset.theme;
      loadHtml2pdf()
        .then(function () {
          var article = document.querySelector('.doc.prose');
          root.dataset.theme = 'light';
          return window
            .html2pdf()
            .set({
              margin: 12,
              filename: (btn.dataset.slug || 'document') + '.pdf',
              image: { type: 'jpeg', quality: 0.95 },
              html2canvas: { scale: 2, backgroundColor: '#ffffff', useCORS: true },
              jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
              pagebreak: {
                mode: ['css', 'legacy'],
                avoid: ['pre', 'table', 'tr', 'blockquote', 'h1', 'h2', 'h3', 'h4', 'li', 'img'],
              },
            })
            .from(article)
            .save();
        })
        .catch(function (err) {
          console.error('PDF generation failed', err);
          window.alert('Could not generate the PDF. Check your connection and try again.');
        })
        .finally(function () {
          if (priorTheme) root.dataset.theme = priorTheme;
          else delete root.dataset.theme;
          btn.disabled = false;
          btn.innerHTML = original;
        });
    });
  })();
</script>

<style>
  .doc-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: 0.5rem;
  }
  .btn--sm {
    padding: var(--space-1) var(--space-3);
    font-size: var(--fs-small);
  }
  .doc-toc {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0.75rem 1rem;
    background: var(--surface-subtle);
    border-left: 3px solid var(--itq-orange);
    border-radius: 4px;
  }
  .doc-toc__label {
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-body);
  }
  .doc-toc__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* The ITQ tokens (base.css) draw a brand square on every ul > li::before;
     in this inline chip list it lands at the end of the previous chip. */
  .doc-toc__list li::before {
    display: none;
  }
  .doc-toc__list a {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    background: var(--surface-card);
    border: 1px solid var(--border-active);
    border-radius: 999px;
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--text-body);
  }
  .doc-toc__list a:hover {
    border-color: var(--itq-orange);
    color: var(--itq-orange);
  }
  /* H3 sub-topics: lighter, smaller chips so the H2 sections still read first */
  .doc-toc__list li.doc-toc__sub a {
    background: transparent;
    border-style: dashed;
    font-size: 0.78rem;
    opacity: 0.85;
  }
  /* Anchor targets inside the rendered markdown: keep headings clear of the sticky header */
  :global(.doc.prose h2),
  :global(.doc.prose h3) {
    scroll-margin-top: 90px;
  }
</style>
