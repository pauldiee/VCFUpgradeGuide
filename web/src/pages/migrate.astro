---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavCard from '../components/NavCard.astro';
import { navMigrationItems, MIGRATION_PLANNED } from '../nav';
import { withBase } from '../lib/path';

const items = navMigrationItems();
---

<BaseLayout
  title="Side-by-side migration"
  description="Build a new VCF or VVF 9 environment next to the old one, carry the configuration over, and migrate the VMs with or without HCX."
  fullWidth
>
  <section class="hero hero--compact">
    <div class="hero__inner">
      <p class="itq-eyebrow hero__eyebrow">Route &middot; Side-by-side migration</p>
      <h1 class="hero__title">Build new, carry the configuration over, then move the VMs.</h1>
      <p class="hero__intro">
        For an environment that goes to VCF or VVF 9 by building a new
        environment next to the old one instead of upgrading in place. Start
        with the overview: it helps you choose the route and walks through the
        phases. Upgrading in place instead? Pick the
        <a href={withBase('vcf/')}>Full VCF</a> or
        <a href={withBase('vvf/')}>standalone VVF</a> track.
      </p>
    </div>
  </section>

  <section class="workflow">
    <div class="workflow__inner">
      <p class="itq-eyebrow">The set, in phase order</p>
      <h2 class="workflow__heading">Side-by-side migration docs</h2>
      <div class="card-grid">
        {items.map((item) => <NavCard item={item} />)}
      </div>
    </div>
  </section>

  <section class="workflow workflow--secondary">
    <div class="workflow__inner">
      <p class="itq-eyebrow">Coming</p>
      <h2 class="workflow__heading">Planned pages in this set</h2>
      <div class="card-grid">
        {
          MIGRATION_PLANNED.map((p) => (
            <div class="planning-card planning-card--planned" aria-disabled="true">
              <div class="planning-card__top">
                <i class={`fa-solid fa-${p.icon} planning-card__icon`} aria-hidden="true" />
              </div>
              <h3 class="planning-card__title">{p.label}</h3>
              <p class="planning-card__blurb">{p.blurb}</p>
              <span class="planning-card__cta">Coming</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
