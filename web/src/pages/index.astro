---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NAV } from '../nav';
import { docHref as href } from '../lib/path';
---

<BaseLayout
  title="VMware Docs"
  description="ITQ's VMware guides. Currently: general VCF upgrade planning guidance, plus hardware-specific addenda (Dell VxRail)."
  fullWidth
>
  <section class="hero hero--compact">
    <div class="hero__inner">
      <p class="itq-eyebrow hero__eyebrow">ITQ &middot; VMware Docs</p>
      <h1 class="hero__title">VCF upgrade guidance for any hardware, plus HCI add-ons.</h1>
    </div>
  </section>

  <section class="workflow">
    <div class="workflow__inner">
      <p class="itq-eyebrow">The flow</p>
      <h2 class="workflow__heading">Upgrade planning docs</h2>
      <div class="card-grid">
        {
          NAV.map((item) => (
            <a class="planning-card" href={href(item.slug)}>
              <div class="planning-card__top">
                <i class={`fa-solid fa-${item.icon} planning-card__icon`} aria-hidden="true" />
              </div>
              <span class="planning-card__step itq-eyebrow">{item.step}</span>
              <h3 class="planning-card__title">{item.label}</h3>
              <p class="planning-card__blurb">{item.blurb}</p>
              <span class="planning-card__cta">
                Open <i class="fa-solid fa-arrow-right" aria-hidden="true" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
