---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavCard from '../components/NavCard.astro';
import { NAV } from '../nav';
import { withBase } from '../lib/path';

const TRACKS = [
  {
    href: withBase('vcf/'),
    icon: 'diagram-project',
    label: 'Full VCF',
    hint: 'SDDC Manager / Fleet Management drives the fleet.',
  },
  {
    href: withBase('vvf/'),
    icon: 'layer-group',
    label: 'Standalone VVF',
    hint: 'VMware vSphere Foundation, no VCF Management Services.',
  },
  // Standalone vSphere track intentionally left out for now – see the
  // exclusion comment in web/src/content.config.ts.
];
---

<BaseLayout
  title="VMware Docs"
  description="ITQ's VMware guides. Currently: general VCF upgrade planning guidance, plus hardware-specific addenda (Dell VxRail)."
  fullWidth
>
  <section class="hero hero--compact">
    <div class="hero__inner">
      <p class="itq-eyebrow hero__eyebrow">ITQ &middot; VMware Docs</p>
      <h1 class="hero__title">VCF upgrade guidance for any hardware, plus HCI add-ons.</h1>
    </div>
  </section>

  <section class="workflow">
    <div class="workflow__inner">
      <p class="itq-eyebrow">Start here</p>
      <h2 class="workflow__heading">Which track are you on?</h2>
      <div class="card-grid card-grid--tracks">
        {
          TRACKS.map((track) => (
            <a class="planning-card planning-card--track" href={track.href}>
              <div class="planning-card__top">
                <i class={`fa-solid fa-${track.icon} planning-card__icon`} aria-hidden="true" />
              </div>
              <h3 class="planning-card__title">{track.label}</h3>
              <p class="planning-card__blurb">{track.hint}</p>
              <span class="planning-card__cta">
                Open <i class="fa-solid fa-arrow-right" aria-hidden="true" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="workflow workflow--secondary">
    <div class="workflow__inner">
      <details>
        <summary class="itq-eyebrow">Browse all docs</summary>
        <div class="card-grid">
          {NAV.map((item) => <NavCard item={item} />)}
        </div>
      </details>
    </div>
  </section>
</BaseLayout>
