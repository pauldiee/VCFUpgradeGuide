---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavCard from '../components/NavCard.astro';
import { navByTrack } from '../nav';
import { withBase } from '../lib/path';

const items = navByTrack('vvf');
---

<BaseLayout
  title="Standalone VVF upgrade track"
  description="Upgrade guidance for VMware vSphere Foundation (VVF) without VCF Management Services."
  fullWidth
>
  <section class="hero hero--compact">
    <div class="hero__inner">
      <p class="itq-eyebrow hero__eyebrow">Track &middot; Standalone VVF</p>
      <h1 class="hero__title">VMware vSphere Foundation, no VCF Management Services.</h1>
      <p class="hero__intro">
        For a VVF fleet with no SDDC Manager or Fleet Management layer –
        compute, storage, networking and admin run through native vSphere
        management, patched with standard vSphere lifecycle mechanisms
        (vLCM). If SDDC Manager <em>is</em> driving the upgrade, use the
        <a href={withBase('vcf/')}>full VCF</a> track instead; if there's no VVF
        entitlement at all, see <a href={withBase('vsphere/')}>standalone vSphere</a>.
      </p>
    </div>
  </section>

  <section class="workflow">
    <div class="workflow__inner">
      <p class="itq-eyebrow">The flow</p>
      <h2 class="workflow__heading">Upgrade planning docs</h2>
      <div class="card-grid">
        {items.map((item) => <NavCard item={item} />)}
      </div>
    </div>
  </section>
</BaseLayout>
